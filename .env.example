# Ford Guardian Ranger Brain v19 backend
# Copy this file to .env on the BACKEND machine only.
# Never place OPENAI_API_KEY in the Android project or APK.
OPENAI_API_KEY=

# Quality-first default supported by current OpenAI API docs. Override if your project uses another compatible model.
OPENAI_MODEL=gpt-5.1
OPENAI_REASONING_EFFORT=medium

# Run `npm run knowledge:setup` once; paste the resulting vs_... ID here.
FORD_RANGER_VECTOR_STORE_ID=

# Recommended for any internet-facing server. Generate with: npm run token:generate
FORD_GUARDIAN_CLIENT_TOKEN=

# Public-source lookup is restricted to Ford/Haynes domains.
OFFICIAL_WEB_SEARCH=true
OFFICIAL_WEB_SEARCH_CONTEXT=medium

PORT=8787
MAX_REQUESTS_PER_MINUTE=30
MAX_HISTORY_MESSAGES=20
MAX_OUTPUT_TOKENS=2200
